{
  "name": "TimberlineTycoon",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$path": "src/ReplicatedFirst"
    },
    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage"
    },
    "ServerScriptService": {
      "$path": "src/ServerScriptService"
    },
    "StarterGui": {
      "$path": "src/StarterGui"
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "MaxPlayers": 12
      }
    },
    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "StreamingEnabled": true,
        "ModelStreamingBehavior": "Improved",
        "StreamingIntegrityMode": "PauseOutsideLoadedArea",
        "StreamingMinRadius": 128,
        "StreamingTargetRadius": 640,
        "StreamOutBehavior": "Opportunistic",
        "GlobalWind": [
          6,
          0,
          3
        ]
      },
      "Terrain": {
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Decoration": true,
          "GrassLength": 0.5
        }
      }
    },
    "MaterialService": {
      "$className": "MaterialService",
      "$path": "src/MaterialService",
      "$ignoreUnknownInstances": true
    },
    "Lighting": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": false,
        "ShadowSoftness": 0.35,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.35,
        "GeographicLatitude": 35,
        "Attributes": {
          "RBX_BackupBrightness": { "Float32": 1 },
          "RBX_BackupExposureCompensation": { "Float32": 0 },
          "RBX_LightingCompatibilityMigrated": { "Bool": true },
          "RBX_LightingTechnologyUnifiedMigration": { "Bool": true },
          "RBX_OriginalTechnologyOnFileLoad": { "Int32": 2 }
        }
      }
    }
  }
}
