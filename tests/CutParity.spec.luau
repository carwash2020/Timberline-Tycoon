	-- The twelve woods on main when this was pinned. Cherry and Willow (WORLD-T323)
	-- are pinned in their own block below.
	local MAIN_WOODS = {}
	for _, wood in ipairs(Wood.All()) do
		if wood.id ~= "cherry" and wood.id ~= "willow" then
			table.insert(MAIN_WOODS, wood)
		end
	end

	local function fmt(n)
		return string.format("%.6f", n)
	end

	local function measured(woods)
		local lines = {}
		for _, wood in ipairs(woods) do
			for _, mill in ipairs(Catalog.SawmillList()) do
				local s = Sawmill.DefaultSettings(mill)
				for _, vol in ipairs({ 12, 40 }) do
					local planks = Sawmill.Cut(vol, s, mill)
					local parts = {}
					local total = 0
					for _, p in ipairs(planks) do
						table.insert(parts, fmt(p.sx) .. "x" .. fmt(p.sy) .. "x" .. fmt(p.sz))
						total += Sell.PieceValue(
							wood.id,
							"plank",
							Sell.VolumeU3(p.sx, p.sy, p.sz),
							nil,
							nil,
							nil,
							mill.plankBonus
						)
					end
					table.insert(
						lines,
						wood.id .. "|" .. mill.id .. "|" .. vol .. "|" .. table.concat(parts, ",") .. "|" .. fmt(total)
					)
				end
			end
		end
		for _, wood in ipairs(woods) do
			for _, machine in ipairs(Planer.List()) do
				local def = machine.planer
				local s = Planer.Default(def)
				for _, plank in ipairs({ { 1.6, 17.44, 0.96 }, { 2.4, 9, 1.6 }, { 1.6, 5, 0.96 } }) do
					local view = {
						kind = "plank",
						sections = { { length = plank[2], sx = plank[1], sz = plank[3], children = 0 } },
					}
					local ok, why, out = Planer.Plane(view, def, s)
					local vol = 0
					local text = tostring(ok) .. tostring(why)
					if ok then
						vol = Planer.Volume(out)
						text = fmt(out.sx) .. "x" .. fmt(out.sy) .. "x" .. fmt(out.sz)
					end
					local value = Sell.PieceValue(wood.id, "plank", vol, nil, nil, nil, 1, Planer.Bonus(def))
					table.insert(
						lines,
						"PLANE " .. wood.id .. "|" .. machine.id .. "|" .. text .. "|" .. fmt(vol) .. "|" .. fmt(value)
					)
				end
			end
			for _, cutU in ipairs({ 1, 8, 20, 32 }) do
				local graph = Chop.Trunk(40, 1.6)
				local pieces = Chop.Dice(graph, Chop.Clamp(cutU) * Config.WoodUnit)
				local parts = {}
				local total = 0
				for _, g in ipairs(pieces) do
					local _, node = next(g)
					table.insert(parts, fmt(node.length))
					local v = Sell.VolumeU3(node.thickness, node.length, node.thickness)
					total += Sell.PieceValue(wood.id, "log", v)
				end
				table.insert(
					lines,
					"CHOP " .. wood.id .. "|" .. cutU .. "|" .. table.concat(parts, ",") .. "|" .. fmt(total)
				)
			end
		end
		return lines
	end

