--!nocheck
return function(t)
	local SettingsLogic = t.shared("SettingsLogic")

	t.test("missing keys become the defaults, and bad values are rejected", function()
		local s = SettingsLogic.Sanitize({ music = false })
		t.eq(s.music, false)
		t.eq(s.sfx, true)
		t.eq(s.musicVolume, 1)
		t.eq(s.graphics, "auto")
		t.eq(s.uiScale, "normal")
		t.eq(s.showTips, true)
		t.eq(s.cameraShake, true)
		local junk = SettingsLogic.Sanitize({ graphics = "ultra", uiScale = "huge", musicVolume = 4, sfxVolume = -1 })
		t.eq(junk.graphics, "auto")
		t.eq(junk.uiScale, "normal")
		t.eq(junk.musicVolume, 1)
		t.eq(junk.sfxVolume, 1)
		t.ok(SettingsLogic.Set(s, "musicVolume", 0.4))
		t.eq(s.musicVolume, 0.4)
		t.ok(not SettingsLogic.Set(s, "musicVolume", 2))
		t.eq(s.musicVolume, 0.4)
		t.ok(SettingsLogic.Set(s, "graphics", "low"))
		t.eq(s.graphics, "low")
		t.ok(not SettingsLogic.Set(s, "graphics", "nope"))
		t.ok(not SettingsLogic.Set(s, "nope", true))
		t.eq(SettingsLogic.ScaleMultiplier("small"), 0.85)
		t.eq(SettingsLogic.ScaleMultiplier("large"), 1.15)
		t.eq(SettingsLogic.ScaleMultiplier("normal"), 1)
	end)
end
