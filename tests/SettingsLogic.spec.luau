--!nocheck
return function(t)
	local SettingsLogic = t.shared("SettingsLogic")

	t.test("missing keys become the defaults, and bad values are rejected", function()
		local s = SettingsLogic.Sanitize({ music = false })
		t.eq(s.music, false)
		t.eq(s.sfx, true)
		t.eq(s.musicVolume, 1)
		t.eq(s.graphics, "auto")
		t.eq(s.uiScale, "normal")
		t.eq(s.showTips, true)
		t.eq(s.cameraShake, true)
		local junk = SettingsLogic.Sanitize({ graphics = "ultra", uiScale = "huge", musicVolume = 4, sfxVolume = -1 })
		t.eq(junk.graphics, "auto")
		t.eq(junk.uiScale, "normal")
		t.eq(junk.musicVolume, 1)
		t.eq(junk.sfxVolume, 1)
		t.ok(SettingsLogic.Set(s, "musicVolume", 0.4))
		t.eq(s.musicVolume, 0.4)
		t.ok(not SettingsLogic.Set(s, "musicVolume", 2))
		t.eq(s.musicVolume, 0.4)
		t.ok(SettingsLogic.Set(s, "graphics", "low"))
		t.eq(s.graphics, "low")
		t.ok(not SettingsLogic.Set(s, "graphics", "nope"))
		t.ok(not SettingsLogic.Set(s, "nope", true))
		t.eq(SettingsLogic.ScaleMultiplier("small"), 0.85)
		t.eq(SettingsLogic.ScaleMultiplier("large"), 1.15)
		t.eq(SettingsLogic.ScaleMultiplier("normal"), 1)
		t.ok(SettingsLogic.HasTab("game"))
		t.ok(SettingsLogic.HasTab("visitors"))
		t.ok(not SettingsLogic.HasTab("land"))
		t.ok(SettingsLogic.HasTab("board"))
	end)

	t.test("the Lower / Higher quality choice: unset until picked, then low or high, nothing else", function()
		t.eq(SettingsLogic.Defaults.quality, "unset")
		t.eq(SettingsLogic.Sanitize(nil).quality, "unset", "a new save")
		t.eq(SettingsLogic.Sanitize({ music = false }).quality, "unset", "an old save without the key")
		t.eq(SettingsLogic.Sanitize({ quality = "low" }).quality, "low")
		t.eq(SettingsLogic.Sanitize({ quality = "high" }).quality, "high")
		t.eq(SettingsLogic.Sanitize({ quality = "medium" }).quality, "unset", "no third choice")
		t.eq(SettingsLogic.Sanitize({ quality = 3 }).quality, "unset")
		t.eq(SettingsLogic.Sanitize({ quality = true }).quality, "unset")
		t.eq(SettingsLogic.Attributes.quality, "SettingQuality")
		local s = SettingsLogic.Sanitize(nil)
		t.ok(SettingsLogic.Set(s, "quality", "high"))
		t.eq(s.quality, "high")
		t.ok(SettingsLogic.Set(s, "quality", "low"))
		t.eq(s.quality, "low")
		for _, bad in ipairs({ "unset", "medium", "auto", "", "LOW", 1, true, {}, false }) do
			t.ok(not SettingsLogic.Set(s, "quality", bad), "refuses " .. tostring(bad))
			t.eq(s.quality, "low", "and leaves the save alone")
		end
		t.ok(not SettingsLogic.Set(s, "quality", nil))
		-- The old four-way override still loads, and is not what the choice reads.
		t.eq(SettingsLogic.Sanitize({ graphics = "medium" }).graphics, "medium")
		t.eq(SettingsLogic.Sanitize({ graphics = "medium" }).quality, "unset")
	end)

	t.test("showOnBoard is off by default, and only a real true opts in", function()
		t.eq(SettingsLogic.Defaults.showOnBoard, false)
		t.eq(SettingsLogic.Sanitize(nil).showOnBoard, false)
		t.eq(SettingsLogic.Sanitize({ music = false }).showOnBoard, false, "an old save without the key")
		t.eq(SettingsLogic.Sanitize({ showOnBoard = true }).showOnBoard, true)
		t.eq(SettingsLogic.Sanitize({ showOnBoard = "yes" }).showOnBoard, false)
		t.eq(SettingsLogic.Sanitize({ showOnBoard = 1 }).showOnBoard, false)
		t.eq(SettingsLogic.Attributes.showOnBoard, "SettingShowOnBoard")
		t.eq(SettingsLogic.BoardAttribute, "SettingShowOnBoard")
		local s = SettingsLogic.Sanitize(nil)
		t.ok(SettingsLogic.Set(s, "showOnBoard", true))
		t.eq(s.showOnBoard, true)
		t.ok(not SettingsLogic.Set(s, "showOnBoard", "true"))
		t.ok(not SettingsLogic.Set(s, "showOnBoard", nil))
		t.eq(s.showOnBoard, true)
		t.ok(SettingsLogic.Set(s, "showOnBoard", false))
		t.eq(s.showOnBoard, false)
	end)

	t.test("the Visitors tab lists who you can visit and sends VisitPlot, with big text and touch targets", function()
		local fs = require("@lune/fs")
		local ui = fs.readFile("src/StarterPlayer/StarterPlayerScripts/SettingsUI.luau")
		t.ok(string.find(ui, "PermissionLogic.VisitList", 1, true), "the same rule the tests run")
		t.ok(string.find(ui, 'Net.Remote("VisitPlot"):FireServer(who.userId)', 1, true), "an intent, by user id")
		t.ok(string.find(ui, "if tenFoot() then 18 else 14", 1, true), "18 px on a TV")
		t.ok(string.find(ui, 'makeButton(visitors, "Visit"', 1, true), "a button, 44 px or more like every row")
		t.ok(string.find(ui, "GuiService.SelectedObject = first", 1, true), "the pad lands on the first button")
		local Perm = t.shared("PermissionLogic")
		t.ok(Perm.Tap >= 44)
	end)

	t.test("Restart save lives in Settings: only with a chosen save, and not while the cooldown runs", function()
		local row = SettingsLogic.RestartRow
		t.eq(row(nil, false, 0, 100, false).enabled, false, "no save is active: disabled")
		t.eq(row(nil, false, 0, 100, false).text, "RESTART SAVE (pick a save first)")
		t.eq(row(1, true, 0, 100, false).enabled, false, "still choosing a save at the join picker")
		t.eq(row(2, false, 150, 100, false).enabled, false, "the slot cooldown runs")
		t.eq(row(2, false, 150, 100, false).text, "RESTART SAVE (in 50s)")
		t.eq(row(2, false, 0, 100, false), { text = "RESTART SAVE 2", enabled = true })
		t.eq(row(2, false, 0, 100, true), { text = "PRESS AGAIN: WIPE SAVE 2", enabled = true })
		t.eq(row("1", false, 0, 100, false).enabled, false, "a made-up attribute is not a save")
		t.eq(row(0, false, 0, 100, false).enabled, false)
	end)

	t.test(
		"Restart save: two presses through the same server path as the old Redo, and the list has no wipe button",
		function()
			local fs = require("@lune/fs")
			local ui = fs.readFile("src/StarterPlayer/StarterPlayerScripts/SettingsUI.luau")
			t.ok(
				string.find(ui, 'Net.Remote("SlotAction"):FireServer("arm", 0, false)', 1, true),
				"the first press arms"
			)
			t.ok(string.find(ui, 'Net.Remote("SlotAction"):FireServer("reset", 0, true)', 1, true), "the second wipes")
			t.ok(string.find(ui, "SettingsLogic.RestartRow", 1, true))
			local slots = fs.readFile("src/StarterPlayer/StarterPlayerScripts/SaveSlotUI.luau")
			t.eq(string.find(slots, '"reset"', 1, true), nil, "the save list can no longer wipe a save")
			local service = fs.readFile("src/ServerScriptService/SaveSlotService.luau")
			t.ok(string.find(service, 'RateLimiter.Allow(player, "SlotAction")', 1, true), "still rate limited")
			t.ok(string.find(service, "ARM_SECONDS", 1, true), "still two steps on the server")
			t.ok(SettingsLogic.RestartArmSeconds <= 20, "the client's window is inside the server's")
		end
	)

	t.test("camera sensitivity: default 1, clamped, idempotent in an old save, junk refused", function()
		local d = SettingsLogic.Sanitize(nil)
		t.eq(d.cameraSensitivity, 1)
		local old = SettingsLogic.Sanitize({ music = false }) -- a save from before the setting
		t.eq(old.cameraSensitivity, 1)
		t.eq(SettingsLogic.Sanitize(old).cameraSensitivity, 1, "Sanitize twice changes nothing")
		t.eq(SettingsLogic.Sanitize({ cameraSensitivity = 50 }).cameraSensitivity, 2, "clamped high")
		t.eq(SettingsLogic.Sanitize({ cameraSensitivity = -3 }).cameraSensitivity, 0.25, "clamped low")
		t.eq(SettingsLogic.Sanitize({ cameraSensitivity = "fast" }).cameraSensitivity, 1)
		t.eq(SettingsLogic.Sanitize({ cameraSensitivity = 0 / 0 }).cameraSensitivity, 1)
		local s = SettingsLogic.Sanitize(nil)
		t.ok(SettingsLogic.Set(s, "cameraSensitivity", 1.5))
		t.eq(s.cameraSensitivity, 1.5)
		t.ok(SettingsLogic.Set(s, "cameraSensitivity", 99))
		t.eq(s.cameraSensitivity, 2, "the server clamps")
		t.ok(not SettingsLogic.Set(s, "cameraSensitivity", "1"))
		t.ok(not SettingsLogic.Set(s, "cameraSensitivity", 0 / 0))
		t.ok(not SettingsLogic.Set(s, "cameraSensitivity", nil))
		t.eq(s.cameraSensitivity, 2, "refused values leave it alone")
		t.eq(SettingsLogic.Attributes.cameraSensitivity, "SettingCameraSensitivity")
	end)

	t.test("camera sensitivity steps wrap and scale the device's own speed", function()
		t.eq(SettingsLogic.NextSensitivity(1), 1.25)
		t.eq(SettingsLogic.NextSensitivity(1.75), 2)
		t.eq(SettingsLogic.NextSensitivity(2), 0.25, "after the highest, the lowest")
		t.eq(SettingsLogic.NextSensitivity(0 / 0), 1.25, "junk counts as 1")
		t.eq(SettingsLogic.ApplySensitivity(0.5, 2), 1)
		t.eq(SettingsLogic.ApplySensitivity(0.5, "x"), 0.5)
	end)

	t.test("the codes tab exists", function()
		t.ok(SettingsLogic.HasTab("codes"))
	end)

	t.test("the Settings card has every launch control, works on all inputs, and binds no right trigger", function()
		local fs = require("@lune/fs")
		local ui = fs.readFile("src/StarterPlayer/StarterPlayerScripts/SettingsUI.luau")
		for _, needle in ipairs({
			'row("music"',
			'row("musicVolume"',
			'row("sfx"',
			'row("sfxVolume"',
			'row("graphics"',
			'row("reset", "REPLAY TUTORIAL"',
			'Net.Remote("ResetTutorial")',
			'Net.Remote("RedeemCode")',
			'"TabCodes"',
		}) do
			t.ok(string.find(ui, needle, 1, true), needle .. " is in the Settings card")
		end
		t.eq(
			string.find(ui, 'row("cameraSensitivity"', 1, true),
			nil,
			"no camera speed row: that setting is not ours to write"
		)
		t.ok(string.find(ui, "InputKit.Actions.Cancel.gamepad", 1, true), "B closes")
		t.ok(string.find(ui, "UITheme.Size.Tap", 1, true), "every tap target is at least the 44 px tap size")
		t.eq(string.find(ui, "ButtonR2", 1, true), nil)
	end)

	t.test("TIPS off hides tips, but never during a tutorial step; the default is on", function()
		t.eq(SettingsLogic.TipsShown(nil, 0), true, "default on")
		t.eq(SettingsLogic.TipsShown(true, 0), true)
		t.eq(SettingsLogic.TipsShown("odd", 0), true, "odd data keeps the default")
		t.eq(SettingsLogic.TipsShown(false, 0), false, "off, tutorial done")
		t.eq(SettingsLogic.TipsShown(false, nil), false, "off, still loading")
		t.eq(SettingsLogic.TipsShown(false, 1), true, "off, but a tutorial step is running")
		t.eq(SettingsLogic.TipsShown(false, 8), true)
		t.eq(SettingsLogic.TipsShown(false, 0 / 0), false, "NaN step is not a step")
	end)

	t.test("HUD and QuestService read the TIPS rule for the hint bar, tip toasts and the climate tip", function()
		local fs = require("@lune/fs")
		local hud = fs.readFile("src/StarterPlayer/StarterPlayerScripts/HUD.luau")
		t.ok(string.find(hud, "SettingsLogic.TipsShown(tipsOn", 1, true), "HUD asks the rule")
		t.ok(string.find(hud, "NoticePolicy.IsTip(options)", 1, true), "tip toasts are filtered")
		local quest = fs.readFile("src/ServerScriptService/QuestService.luau")
		t.ok(string.find(quest, "SettingsLogic.TipsShown(", 1, true), "the climate tip asks the rule")
	end)

	t.test("reduce flashing: default off, boolean only, forced on by camera shake off, softens flashes", function()
		t.eq(SettingsLogic.Defaults.reduceFlashing, false)
		t.eq(SettingsLogic.Sanitize(nil).reduceFlashing, false)
		t.eq(SettingsLogic.Sanitize({ reduceFlashing = true }).reduceFlashing, true)
		t.eq(SettingsLogic.Sanitize({ reduceFlashing = "true" }).reduceFlashing, false)
		t.eq(SettingsLogic.Sanitize({ reduceFlashing = 1 }).reduceFlashing, false)
		-- Sanitising twice is the same as once.
		local once = SettingsLogic.Sanitize({ reduceFlashing = true, music = false })
		t.eq(SettingsLogic.Sanitize(once).reduceFlashing, true)
		t.eq(SettingsLogic.Attributes.reduceFlashing, "SettingReduceFlashing")
		t.eq(SettingsLogic.ReduceFlashingAttribute, "SettingReduceFlashing")
		local s = SettingsLogic.Sanitize(nil)
		t.ok(SettingsLogic.Set(s, "reduceFlashing", true))
		t.eq(s.reduceFlashing, true)
		for _, bad in ipairs({ "on", 1, {}, 0 }) do
			t.ok(not SettingsLogic.Set(s, "reduceFlashing", bad), "refuses " .. tostring(bad))
		end
		t.eq(s.reduceFlashing, true)
		-- In force: its own setting, or camera shake off; a missing attribute means off / shake on.
		t.eq(SettingsLogic.ReduceFlashing(nil, nil), false)
		t.eq(SettingsLogic.ReduceFlashing(false, true), false)
		t.eq(SettingsLogic.ReduceFlashing(true, true), true)
		t.eq(SettingsLogic.ReduceFlashing(nil, false), true)
		t.eq(SettingsLogic.ReduceFlashing(false, false), true)
		-- A flash: unchanged normally; reduced = the first only, dimmer and longer; a later one is dropped.
		local f = SettingsLogic.SoftenFlash(false, 2, 0.08, nil)
		t.eq(f.amount, 2)
		t.eq(f.duration, 0.08)
		f = SettingsLogic.SoftenFlash(false, 1.2, 0.06, 0.14)
		t.eq(f.amount, 1.2)
		t.eq(f.duration, 0.06)
		f = SettingsLogic.SoftenFlash(true, 2, 0.08, nil)
		t.eq(f.amount, 0.5)
		t.eq(f.duration, SettingsLogic.ReducedFlashSeconds)
		t.ok(SettingsLogic.ReducedFlashSeconds > 0.3, "slow enough to never read as a strobe")
		t.eq(SettingsLogic.SoftenFlash(true, 1.2, 0.06, 0.14), nil)
	end)
end
