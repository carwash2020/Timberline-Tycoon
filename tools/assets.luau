--!nocheck
-- Writes ASSETS.md: every Roblox asset id the source mentions, with what uses
-- it, its kind and its status. The ids come from tools/assetscan (the same
-- scan tests/AssetIds.spec.luau pins), so the list cannot drift from the code.
--
-- Run from the repo root:   lune run tools/assets
-- Check it is current:      lune run tools/assets --check
--
-- It also writes tools/asset-ids.json, the id list scripts/check-assets.ps1
-- reads (so the PowerShell script never parses markdown).
--
-- STATUS here is what the repo can prove. Nothing in this file has been
-- checked against Roblox (the Claude sandbox cannot reach any Roblox
-- endpoint) and nothing has been seen in Studio. "format ok" means the id is
-- a well-formed number of the right length for its kind; it does not mean the
-- asset exists, is the right type, or is allowed to load in the experience.

local fs = require("@lune/fs")
local luau = require("@lune/luau")
local process = require("@lune/process")
local serde = require("@lune/serde")

assert(fs.isFile("rokit.toml"), "Run this from the repo root: lune run tools/assets")

local Scan = luau.load(fs.readFile("tools/assetscan.luau"), { debugName = "tools/assetscan.luau" })()

local records = Scan.Scan()

local KIND_ORDER = { "mesh", "model", "template", "image", "texture", "sound", "pass", "product" }
local KIND_TITLE = {
	mesh = "Meshes (MeshId, loaded by MeshKit)",
	model = "Model containers (Open Cloud uploads; never a MeshId)",
	template = "MeshTemplates files (Rojo MeshPart fallback, one per id)",
	image = "Images (ImageLabel, store cards, particle textures)",
	texture = "Material textures (MaterialService variants)",
	sound = "Sounds",
	pass = "Game passes",
	product = "Developer products",
}

local function short(path: string): string
	return (string.gsub(path, "^src/", ""))
end

local function line(...)
	return table.concat({ ... }, "")
end

type Group = { id: number, digits: string, kind: string, uses: { any } }

local groups: { [string]: Group } = {}
local order: { string } = {}
for _, record in ipairs(records) do
	local key = record.kind .. ":" .. record.digits
	local group = groups[key]
	if not group then
		group = { id = record.id, digits = record.digits, kind = record.kind, uses = {} }
		groups[key] = group
		table.insert(order, key)
	end
	table.insert(group.uses, record)
end

local templateIds: { [string]: boolean } = {}
local meshIds: { [string]: boolean } = {}
for _, group in pairs(groups) do
	if group.kind == "template" then
		templateIds[group.digits] = true
	elseif group.kind == "mesh" then
		meshIds[group.digits] = true
	end
end

local function distinctFiles(group: Group): { string }
	local seen, files = {}, {}
	for _, use in ipairs(group.uses) do
		local name = string.match(use.path, "([^/]+)$") :: string
		if not seen[name] then
			seen[name] = true
			table.insert(files, name)
		end
	end
	table.sort(files)
	return files
end

local out: { string } = {}
local function emit(text: string)
	table.insert(out, text)
end

