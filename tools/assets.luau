for _, kind in ipairs(KIND_ORDER) do
	local distinct, places = 0, 0
	local files: { [string]: boolean } = {}
	for _, key in ipairs(order) do
		local group = groups[key]
		if group.kind == kind then
			distinct += 1
			places += #group.uses
			for _, name in ipairs(distinctFiles(group)) do
				files[name] = true
			end
		end
	end
	local names: { string } = {}
	for name in pairs(files) do
		table.insert(names, name)
	end
	table.sort(names)
	if kind == "template" then
		emit(
			line(
				"| ",
				kind,
				" | ",
				tostring(distinct),
				" | ",
				tostring(places),
				" | src/ReplicatedStorage/MeshTemplates |"
			)
		)
	else
		emit(
			line("| ", kind, " | ", tostring(distinct), " | ", tostring(places), " | ", table.concat(names, ", "), " |")
		)
	end
end
