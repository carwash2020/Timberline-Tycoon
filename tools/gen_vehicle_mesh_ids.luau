--!nocheck
-- Makes src/ReplicatedStorage/Shared/Art/VehicleMeshIds.luau from assets/vehicles/t421/mesh_ids.txt (78 lines: 48 trailer,
-- 6 Timber Classic and 24 recoloured-truck meshes).
--   lune run tools/gen_vehicle_mesh_ids            write the module
--   lune run tools/gen_vehicle_mesh_ids --check    fail if the module is not what the file makes (check.sh)
-- A line is `<Name> = <digits>`; an empty id is allowed and means the mesh is missing. A name is
-- <Trailer>_<Truck>_<Part> (key <Trailer>/<Truck>/<Part>), TimberClassic_<Part> (key TimberClassic/<Part>) or
-- trucks/<Truck>/<Part> (the key as written). Lines starting with # and blank lines are skipped.

local fs = require("@lune/fs")
local process = require("@lune/process")

assert(fs.isFile("rokit.toml"), "Run this from the repo root")

local SOURCES = { "assets/vehicles/t421/mesh_ids.txt" }
local OUT = "src/ReplicatedStorage/Shared/Art/VehicleMeshIds.luau"

local keys: { string } = {}
local ids: { [string]: string } = {}
for _, source in ipairs(SOURCES) do
	for line in string.gmatch(fs.readFile(source), "[^\r\n]+") do
		if string.match(line, "^%s*#") or string.match(line, "^%s*$") then
			continue -- a comment or a blank line
		end
		local name, id = string.match(line, "^%s*([%w_/]+)%s*=%s*(%d*)%s*$")
		assert(name, "bad line in " .. source .. ": " .. line)
		-- trailers and the Timber Classic are written with underscores (PonyTrailer_Pickup_Body), the four trucks with
		-- slashes (trucks/Pickup/Body, already the key)
		local key = if string.find(name, "/", 1, true) then name else (string.gsub(name, "_", "/"))
		assert(ids[key] == nil, "duplicate " .. name)
		ids[key] = id
		table.insert(keys, key)
	end
end

local out = {
	"--!strict",
	"-- GENERATED by tools/gen_vehicle_mesh_ids.luau from assets/vehicles/t421/mesh_ids.txt. Do not edit.",
	"-- Key <Trailer>/<Truck>/<Part> or TimberClassic/<Part>; an empty string means the mesh is missing.",
	"return {",
	"\tkeys = {",
}
for _, key in ipairs(keys) do
	table.insert(out, string.format('\t\t"%s",', key))
end
table.insert(out, "\t},")
table.insert(out, "\tids = {")
for _, key in ipairs(keys) do
	table.insert(out, string.format('\t\t["%s"] = "%s",', key, ids[key]))
end
table.insert(out, "\t} :: { [string]: string },")
table.insert(out, "}")
local text = table.concat(out, "\n") .. "\n"

if process.args[1] == "--check" then
	if not fs.isFile(OUT) or fs.readFile(OUT) ~= text then
		print(OUT .. " is out of date: run lune run tools/gen_vehicle_mesh_ids")
		process.exit(1)
	end
	print("VehicleMeshIds.luau is current")
else
	fs.writeFile(OUT, text)
	print("wrote " .. OUT .. " (" .. #keys .. " keys)")
end
