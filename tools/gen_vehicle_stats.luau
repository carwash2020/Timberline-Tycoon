--!nocheck
-- Makes src/ReplicatedStorage/Shared/Art/VehicleStats.luau from assets/vehicles/t421/glb/**/stats.json (T421's data).
--   lune run tools/gen_vehicle_stats            write the module
--   lune run tools/gen_vehicle_stats --check    fail if the module is not what the files make (check.sh)
-- Trailers: per variant, each piece's size and `at` (trailer-local: bed middle z 0, hitch toward -Z, ground y 0), the
-- axles and the wheel centres. The Timber Classic: each piece's size and `at` and its four wheel centres.

local fs = require("@lune/fs")
local process = require("@lune/process")
local serde = require("@lune/serde")

assert(fs.isFile("rokit.toml"), "Run this from the repo root")
local ROOT = "assets/vehicles/t421/glb/"
local OUT = "src/ReplicatedStorage/Shared/Art/VehicleStats.luau"
local TRAILERS = { "PonyTrailer", "RanchTrailer", "HeavyHauler" }
local VARIANTS = { "Rustbucket", "Pickup", "Flatbed", "LoggingRig" }

local function n(v: number): string
	return (string.gsub(string.format("%.4f", v), "%.?0+$", ""))
end
local function v3(a): string
	return string.format("Vector3.new(%s, %s, %s)", n(a[1]), n(a[2]), n(a[3]))
end
local function read(path)
	return serde.decode("json", fs.readFile(path))
end

local out = {
	"--!strict",
	"-- GENERATED by tools/gen_vehicle_stats.luau from assets/vehicles/t421/glb/**/stats.json. Do not edit.",
	"-- Trailer pieces are trailer-local (bed middle z 0, hitch toward -Z, ground y 0).",
	"export type Piece = { size: Vector3, at: Vector3 }",
	"export type TrailerStats = { pieces: { [string]: Piece }, axles: { number }, wheelX: number, wheelSize: Vector3 }",
	"local VehicleStats = {}",
	"VehicleStats.Trailers = {} :: { [string]: { [string]: TrailerStats } }",
}
for _, trailer in ipairs(TRAILERS) do
	table.insert(out, string.format("VehicleStats.Trailers.%s = {", trailer))
	for _, variant in ipairs(VARIANTS) do
		local d = read(ROOT .. trailer .. "/" .. variant .. "/stats.json")
		table.insert(out, string.format("\t%s = {", variant))
		table.insert(out, "\t\tpieces = {")
		for _, role in ipairs({ "Body", "Lights", "Bed", "Hitch" }) do
			local s = d.stats[role]
			table.insert(out, string.format("\t\t\t%s = { size = %s, at = %s },", role, v3(s.size), v3(s.at)))
		end
		table.insert(out, "\t\t},")
		local axles = {}
		for _, a in ipairs(d.axles) do
			table.insert(axles, n(a))
		end
		table.insert(out, string.format("\t\taxles = { %s },", table.concat(axles, ", ")))
		local centres = d.stats.Wheel.wheelCentres
		table.insert(out, string.format("\t\twheelX = %s,", n(math.abs(centres[1][1]))))
		table.insert(out, string.format("\t\twheelSize = %s,", v3(d.stats.Wheel.size)))
		table.insert(out, "\t},")
	end
	table.insert(out, "}")
end
local c = read(ROOT .. "TimberClassic/stats.json")
table.insert(out, "VehicleStats.TimberClassic = {")
table.insert(out, "\tpieces = {")
for _, role in ipairs({ "Body", "Glass", "Lights", "Bed", "Hitch" }) do
	table.insert(out, string.format("\t\t%s = { size = %s, at = %s },", role, v3(c[role].size), v3(c[role].at)))
end
table.insert(out, "\t} :: { [string]: Piece },")
table.insert(out, string.format("\twheelSize = %s,", v3(c.Wheel.size)))
table.insert(out, "\twheelCentres = {")
for _, w in ipairs(c.Wheel.wheelCentres) do
	table.insert(out, string.format("\t\t%s,", v3(w)))
end
table.insert(out, "\t},")
table.insert(out, "}")
table.insert(out, "return VehicleStats")
local text = table.concat(out, "\n") .. "\n"

if process.args[1] == "--check" then
	if not fs.isFile(OUT) or fs.readFile(OUT) ~= text then
		print(OUT .. " is out of date: run lune run tools/gen_vehicle_stats")
		process.exit(1)
	end
	print("VehicleStats.luau is current")
else
	fs.writeFile(OUT, text)
	print("wrote " .. OUT)
end
