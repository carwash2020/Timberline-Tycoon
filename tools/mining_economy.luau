--!nocheck
-- Mining income against wood. Run from the repo root:
--   lune run tools/mining_economy
-- Fails when any tier's best mining $/h is over 0.8 times that stage's
-- best wood, or when ECONOMY.md's supply caps moved and MiningLogic
-- still quotes the old ones. Writes MINING.md. Does not touch ECONOMY.md.

local fs = require("@lune/fs")
local luau = require("@lune/luau")

assert(fs.isFile("rokit.toml"), "Run this from the repo root: lune run tools/mining_economy")

local Loader = luau.load(fs.readFile("tools/loader.luau"), { debugName = "tools/loader.luau" })()
local modules = Loader.new()
local OreData = modules:shared("Mining/OreData")
local PickaxeData = modules:shared("Mining/PickaxeData")
local MiningLogic = modules:shared("Mining/MiningLogic")

-- The first proposal, before tier 3 was cut to fit 0.8 x Gloamwood.
local PROPOSAL = {
	Coal = { chunk = 6, ingot = nil },
	Copper = { chunk = 10, ingot = 28 },
	Iron = { chunk = 16, ingot = 45 },
	Silver = { chunk = 40, ingot = 110 },
	Gold = { chunk = 65, ingot = 180 },
	TimberOpal = { chunk = 150, ingot = 400 },
	Heartstone = { chunk = 400, ingot = 1050 },
}

local function supplyCap(marker: string): number?
	for line in string.gmatch(fs.readFile("ECONOMY.md"), "[^\n]+") do
		if string.find(line, marker, 1, true) then
			local last = nil
			for n in string.gmatch(line, "%$([%d,]+)") do
				last = tonumber((string.gsub(n, ",", "")))
			end
			return last
		end
	end
	return nil
end

local WOOD = {
	{ key = "hills", marker = "| The Hills | Pine |", label = "Hills Pine" },
	{ key = "snow", marker = "| Snowfields | Frostwood |", label = "Snowfields Frostwood" },
	{ key = "gloam", marker = "| Gloam Hollow | Gloamwood |", label = "Gloam Hollow Gloamwood" },
}

for _, row in ipairs(WOOD) do
	local parsed = supplyCap(row.marker)
	local quoted = MiningLogic.WoodIncome[row.key]
	if parsed ~= quoted then
		error(
			string.format(
				"%s supply cap is %s in ECONOMY.md and %s in MiningLogic.WoodIncome",
				row.label,
				tostring(parsed),
				tostring(quoted)
			)
		)
	end
end

local function dollars(n: number): string
	local s = tostring(math.floor(n + 0.5))
	local out = string.reverse(s):gsub("(%d%d%d)", "%1,"):reverse()
	return "$" .. (string.gsub(out, "^,", ""))
end

local function tunedValues()
	local values = {}
	for _, ore in ipairs(OreData.All()) do
		values[ore.id] = { chunk = ore.chunkValue, ingot = ore.ingotValue }
	end
	return values
end

local function netValue(oreId: string, values)
	local row = values[oreId]
	if row == nil then
		return 0
	end
	if row.ingot == nil then
		return row.chunk
	end
	local coal = values.Coal.chunk / MiningLogic.CoalBatch
	return math.max(row.chunk, row.ingot - coal)
end

local function incomeWith(tier: number, pickId: string, values): number
	local pick = PickaxeData.Get(pickId)
	if pick == nil then
		return 0
	end
	local mix = MiningLogic.Mix[tier]
	if mix == nil then
		return 0
	end
	local options = {}
	for _, slot in ipairs(mix) do
		local ore = OreData.Get(slot.id)
		if ore and pick.level >= ore.hardness then
			local hits = math.ceil(ore.hp / MiningLogic.HitDamage)
			local swing = hits * (MiningLogic.BaseSwing / math.max(pick.speed, 0.1))
			local haul = (MiningLogic.HaulStuds[ore.tier] or 40) / MiningLogic.WalkSpeed
			local smelt = if values[slot.id].ingot ~= nil then MiningLogic.SmeltSec else 0
			local cycle = swing + haul + smelt
			local player = if cycle > 0 then netValue(slot.id, values) / cycle * 3600 else 0
			local supply = slot.n * (3600 / ore.respawnSec) * netValue(slot.id, values)
			if player > 0 and supply > 0 then
				table.insert(options, { player = player, supply = supply })
			end
		end
	end
	table.sort(options, function(a, b)
		return a.player > b.player
	end)
	local total, left = 0, 1
	for _, opt in ipairs(options) do
		if left <= 1e-9 then
			break
		end
		local share = math.min(left, opt.supply / opt.player)
		total += share * opt.player
		left -= share
	end
	return total
end

local tuned = tunedValues()
local report = MiningLogic.StageReport()
local lines = {}
local function add(s)
	table.insert(lines, s)
end

add("# Mining income")
add("")
add("_Generated by `lune run tools/mining_economy`. Don't edit by hand._")
add("")
add(
	'Mining $/h is the supply of **one chamber** (the mix in `MiningLogic.Mix`). A faster pick cannot outrun respawn. Net value is the better of the chunk and the ingot after the coal a smelt burns (`chunkValue / 4`). Comparison wood is ECONOMY.md\'s "$/h cap a player (shared by 4)" column: Hills Pine, Snowfields Frostwood (higher than Emberwood), Gloamwood. That is the biome supply cap, not the buying-path wage.'
)
add("")
add(string.format("Cap: mining stays at or under **%.1f×** that wood. The tool fails above it.", MiningLogic.StageCap))
add("")
add("## Tuned, one chamber")
add("")
add("| Stage | Best pick | Mining $/h | Wood $/h | Ratio |")
add("|---|---|---|---|---|")

local failed = false
for _, row in ipairs(report) do
	add(
		string.format(
			"| %s tier %d | %s | %s | %s | %.2f |",
			row.stage,
			row.tier,
			row.pick,
			dollars(row.mining),
			dollars(row.wood),
			row.ratio
		)
	)
	if row.ratio > MiningLogic.StageCap + 1e-9 then
		failed = true
	end
	local check = incomeWith(row.tier, row.pick, tuned)
	if math.abs(check - row.mining) > 1 then
		error(string.format("income replica drifted at %s: %s vs %s", row.stage, tostring(check), tostring(row.mining)))
	end
end

add("")
add("## Every pick, tuned")
add("")
add("| Pick | Tier 1 / Hills | Tier 2 / Snow | Tier 3 / Gloam |")
add("|---|---|---|---|")

local woodByTier = { MiningLogic.WoodIncome.hills, MiningLogic.WoodIncome.snow, MiningLogic.WoodIncome.gloam }
for _, pick in ipairs(PickaxeData.All()) do
	local cells = {}
	for tier = 1, 3 do
		local rate = MiningLogic.Income(tier, pick.id)
		local ratio = rate / woodByTier[tier]
		if ratio > MiningLogic.StageCap + 1e-9 then
			failed = true
		end
		table.insert(cells, string.format("%s (%.2f)", dollars(rate), ratio))
	end
	add(string.format("| %s | %s | %s | %s |", pick.name, cells[1], cells[2], cells[3]))
end

add("")
add("## Proposal, then the tier 3 cut")
add("")
add(
	"Tier 1 and 2 values are the proposal. Tier 3 was cut so a deep chamber stays under 0.8× Gloamwood $7,262. Awaiting Connor: confirm the cut, or name a higher comparison wood."
)
add("")
add("| Ore | Proposal chunk / ingot | Tuned chunk / ingot |")
add("|---|---|---|")
for _, ore in ipairs(OreData.All()) do
	local was = PROPOSAL[ore.id]
	local function pair(chunk, ingot)
		if ingot == nil then
			return string.format("%s / none", dollars(chunk))
		end
		return string.format("%s / %s", dollars(chunk), dollars(ingot))
	end
	add(string.format("| %s | %s | %s |", ore.name, pair(was.chunk, was.ingot), pair(ore.chunkValue, ore.ingotValue)))
end

add("")
add("| Stage | Proposal best $/h | Ratio | Tuned best $/h | Ratio |")
add("|---|---|---|---|---|")
for _, row in ipairs(report) do
	local before = 0
	local beforePick = ""
	for _, pick in ipairs(PickaxeData.All()) do
		local rate = incomeWith(row.tier, pick.id, PROPOSAL)
		if rate > before then
			before = rate
			beforePick = pick.name
		end
	end
	local beforeRatio = before / row.wood
	add(
		string.format(
			"| %s | %s %s | %.2f | %s | %.2f |",
			row.stage,
			dollars(before),
			beforePick,
			beforeRatio,
			dollars(row.mining),
			row.ratio
		)
	)
end

add("")
add("## Time to afford")
add("")
add(
	"Hours at that stage's tuned mining $/h. The Rusty Pick is free. The Lux Pickaxe is not for sale (`passId` 0). Bomb price is `GameConfig.DynamitePrice`."
)
add("")
add("| Item | Price | Hours at Hills | Hours at Snow | Hours at Gloam |")
add("|---|---|---|---|---|")

local function hours(price, rate)
	if price <= 0 then
		return "free"
	end
	if rate <= 0 then
		return "—"
	end
	return string.format("%.2f h", price / rate)
end

local byStage = {}
for _, row in ipairs(report) do
	byStage[row.stage] = row.mining
end
for _, pick in ipairs(PickaxeData.Shop()) do
	add(
		string.format(
			"| %s | %s | %s | %s | %s |",
			pick.name,
			if pick.price > 0 then dollars(pick.price) else "free",
			hours(pick.price, byStage.hills),
			hours(pick.price, byStage.snow),
			hours(pick.price, byStage.gloam)
		)
	)
end
local bomb = MiningLogic.BombPrice()
add(
	string.format(
		"| Bomb | %s | %s | %s | %s |",
		dollars(bomb),
		hours(bomb, byStage.hills),
		hours(bomb, byStage.snow),
		hours(bomb, byStage.gloam)
	)
)

add("")
add(
	"Lux Pickaxe: pass key `LuxPickaxe`, `passId` 0, not in the shop and not in StoreData. Awaiting Connor: a new pass or a bundle with the Lux Axe pass, and the price."
)
add("")

fs.writeFile("MINING.md", table.concat(lines, "\n"))
print(table.concat(lines, "\n"))

if failed or not MiningLogic.StagesOk() then
	error("mining $/h is over 0.8 times that stage's wood")
end
if bomb ~= 220 then
	error("bomb price drifted from GameConfig.DynamitePrice 220")
end
print("mining economy ok")
